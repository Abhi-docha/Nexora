# =========================================================================
# NEXORA ENTERPRISE OPERATIONS CLOUD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Configure production secrets in Netlify
# and Google AI Studio Preview Settings > Secrets.
# =========================================================================

PORT=3000
NODE_ENV=development

# -------------------------------------------------------------------------
# AI Intelligence Provider: OpenRouter (qwen/qwen3.8-27b)
# Server-side only secret. NEVER expose with VITE_ or to client code.
# Obtain your API key at: https://openrouter.ai/keys
# -------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ENABLED=true
AI_ALLOW_PAID_MODELS=true

# -------------------------------------------------------------------------
# Dodo Payments (Test Mode)
# -------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID_STARTER=pdt_0Nov8yee6ubLxUxTanQ4W
DODO_PRODUCT_ID_GROWTH=pdt_0NovCVNy88jYWwd4d1rW4
DODO_PRODUCT_ID_SCALE=pdt_0NovHJulEFup7ug9QD6Rp

# -------------------------------------------------------------------------
# Google Cloud / Firebase Project Configuration
# -------------------------------------------------------------------------
FIREBASE_PROJECT_ID=nexora-enterprise
